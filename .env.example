# .env.example
# Скопируйте этот файл в .env и заполните значениями
# НЕ КОММИТЬТЕ ФАЙЛ .env В GIT!

# =============================================================================
# API И ИНТЕГРАЦИИ
# =============================================================================

# API ключ Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_api_key_here

# Модель Claude
PRIZOLOV_MODEL=claude-sonnet-5-5

# Глубина рассуждений: low, medium, high, xhigh, max
PRIZOLOV_EFFORT=medium

# Максимальная длина одного ответа модели в токенах
PRIZOLOV_MAX_TOKENS=16000

# Рабочая папка агентов: только в ней они читают и пишут файлы
PRIZOLOV_WORKSPACE=workspace

# =============================================================================
# ПАМЯТЬ И ХРАНЕНИЕ
# =============================================================================

# Файл SQLite с памятью агента: диалоги, факты, уроки, версии промптов
PRIZOLOV_DB_PATH=data/prizolov.db

# Самопроверка ответов: complex (только задачи со специалистами), always, off
PRIZOLOV_SELF_CHECK=complex

# =============================================================================
# ЛОГИРОВАНИЕ
# =============================================================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
PRIZOLOV_LOG_LEVEL=INFO

# Путь к файлу логов (оставьте пустым для вывода только в консоль)
PRIZOLOV_LOG_FILE=prizolov.log

# =============================================================================
# БЕЗОПАСНОСТЬ
# =============================================================================

# Уровень безопасности: low, medium, high
PRIZOLOV_SECURITY_LEVEL=high

# =============================================================================
# ПОВЕДЕНИЕ СИСТЕМЫ
# =============================================================================

# Максимальное количество попыток выполнения задачи при ошибке
PRIZOLOV_MAX_RETRIES=3

# Таймаут запросов в секундах (для сетевых операций)
PRIZOLOV_TIMEOUT=30
