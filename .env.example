# .env.example
# Скопируйте этот файл в .env и заполните значениями
# НЕ КОММИТЬТЕ ФАЙЛ .env В GIT!

# =============================================================================
# API И ИНТЕГРАЦИИ
# =============================================================================

# API ключ Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_api_key_here

# Модель Claude
PRIZOLOV_MODEL=claude-sonnet-5-5

# Глубина рассуждений: low, medium, high, xhigh, max
PRIZOLOV_EFFORT=medium

# Максимальная длина одного ответа модели в токенах
PRIZOLOV_MAX_TOKENS=16000

# Рабочая папка агентов: только в ней они читают и пишут файлы
PRIZOLOV_WORKSPACE=workspace

# =============================================================================
# ПАМЯТЬ И ХРАНЕНИЕ
# =============================================================================

# Файл SQLite с памятью агента: диалоги, факты, уроки, версии промптов
PRIZOLOV_DB_PATH=data/prizolov.db

# Самопроверка ответов: complex (только задачи со специалистами), always, off
PRIZOLOV_SELF_CHECK=complex

# Подпись "Создано в Prizolov Agent OS · © Dm.Andreyanov / Prizolov Lab" в файлах .md/.txt/.html от агентов
PRIZOLOV_SIGN_OUTPUT=true

# =============================================================================
# БЮДЖЕТ И ТРАССИРОВКА
# =============================================================================

# Лимиты расходов на Claude API в долларах (0 - без лимита)
PRIZOLOV_BUDGET_TASK_USD=1.0
PRIZOLOV_BUDGET_DAY_USD=10.0

# Журнал всех шагов агентов: logs/trace-ГГГГ-ММ-ДД.jsonl
PRIZOLOV_TRACE=true
PRIZOLOV_TRACE_DIR=logs
# Полные тексты задач и результатов в журнале (могут содержать ваши данные)
PRIZOLOV_TRACE_CONTENT=false

# Сжатие длинного диалога: после стольких токенов старая часть истории заменяется
# кратким содержанием (минимум 50000; 0 - не сжимать)
PRIZOLOV_COMPACT_AT=150000

# Сколько поручений специалистам выполнять одновременно (1 - по очереди)
PRIZOLOV_PARALLEL=4

# =============================================================================
# TELEGRAM-БОТ (prizolov telegram; pip install "prizolov-os[telegram]")
# =============================================================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому разрешён доступ: Telegram ID через запятую (свой ID - у @userinfobot)
PRIZOLOV_TELEGRAM_ALLOWED_IDS=

# Часовой пояс для расписания задач (/schedule)
PRIZOLOV_TIMEZONE=Europe/Moscow

# =============================================================================
# HTTP API (prizolov api; pip install "prizolov-os[api]")
# =============================================================================

# Ключи доступа через запятую, каждый не короче 16 символов. Создать ключ:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PRIZOLOV_API_KEYS=
# Адрес и порт. 127.0.0.1 - только с этого компьютера; 0.0.0.0 - из сети
# (тогда ставьте впереди HTTPS-прокси, например nginx или Caddy)
PRIZOLOV_API_HOST=127.0.0.1
PRIZOLOV_API_PORT=8800
# Сколько задач агентам выполнять одновременно
PRIZOLOV_API_WORKERS=2
# Открыть всем (без ключа) страницу точности прогнозов /public/accuracy.
# На ней видно, по каким активам вы делали прогнозы.
PRIZOLOV_PUBLIC_ACCURACY=false

# =============================================================================
# ЛОГИРОВАНИЕ
# =============================================================================

# Уровень логов в файле PRIZOLOV_LOG_FILE: DEBUG, INFO, WARNING, ERROR, CRITICAL
# (в консоли уровень задаёт команда: подробно - с ключом -v)
PRIZOLOV_LOG_LEVEL=INFO

# Путь к файлу логов (оставьте пустым для вывода только в консоль)
PRIZOLOV_LOG_FILE=prizolov.log

# =============================================================================
# ПОВЕДЕНИЕ СИСТЕМЫ
# =============================================================================

# Повторы запроса к Claude API при временных сбоях
PRIZOLOV_MAX_RETRIES=3

# Таймаут запросов к источникам котировок (Yahoo, Мосбиржа, ЦБ) в секундах
PRIZOLOV_TIMEOUT=30
